# TMDb API Key
# Get your API key from https://www.themoviedb.org/settings/api
# Note: With static export, this key will be visible in the browser bundle
# This is acceptable for TMDb read-only API keys, but be aware of the implications
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Base path for GitHub Pages deployment (optional, defaults to empty string)
# NEXT_PUBLIC_BASE_PATH=/get-to-the-movie
